# Only needed for local development with hot reload (yarn start).
# For production builds leave REACT_APP_BACKEND_URL empty so the site calls /api on its own domain.

# Where the API runs during development
REACT_APP_BACKEND_URL=http://localhost:8001

# Lets the dev server show server-rendered pages (titles, meta tags) like production
SSR_BACKEND_ORIGIN=http://localhost:8001
