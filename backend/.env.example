# Copy to backend/.env and fill in.

# MongoDB connection and database name
MONGO_URL=mongodb://localhost:27017
DB_NAME=uspindia

# Public address of the website (no trailing slash). Used for canonical links,
# sitemap, social previews and password-reset links.
SITE_URL=https://www.uspindia.org

# Browser origins allowed to call the API (comma separated).
# Same-domain hosting: just the site address. Local development: add http://localhost:3000
CORS_ORIGINS=https://www.uspindia.org

# Long random string used to sign logins. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# First admin account — created only when the database has no users yet.
ADMIN_EMAIL=admin@uspindia.org
ADMIN_PASSWORD=change-me

# Optional
# STORAGE_DIR=/var/lib/uspindia/storage   # where uploaded photos live (default: backend/storage)
# PREVIEW_URL=https://www.uspindia.org    # address used in invite/reset links (default: SITE_URL)
# COOKIE_SECURE=false                     # only for testing over plain http on a LAN; keep https in production

# Email (optional). Set the mailbox up in Admin → Enquiries → Form settings.
# If you prefer not to store the mailbox password in the database, put it here instead:
# SMTP_PASSWORD=your-app-password
# Time zone used for the Traffic report's days (default Asia/Kolkata)
# ANALYTICS_TZ=Asia/Kolkata
